{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "incremental": true,
    "outDir": "dist",
    "types": [
      "node"
    ],
    "paths": {
      "*": [
        "./*"
      ],
      "@prisma/client": [
        "./generated/prisma_client/client"
      ]
    },
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "generated",
    "prisma/**",
    "prisma.config.ts"
  ]
}
