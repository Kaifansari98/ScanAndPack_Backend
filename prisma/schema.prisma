  companyVendor CompanyVendorsMaster @relation("GRNSupplier", fields: [company_vendor_id], references: [id])
  createdBy     UserMaster           @relation("GRNCreatedBy", fields: [created_by], references: [id])
  updatedBy     UserMaster?          @relation("GRNUpdatedBy", fields: [updated_by], references: [id])
  confirmedBy   UserMaster?          @relation("GRNConfirmedBy", fields: [confirmed_by], references: [id])

  items            GRNItem[]
  debitCreditNotes DebitCreditNote[]
  paymentSchedules POPaymentSchedule[] @relation("GRNPaymentSchedules")

