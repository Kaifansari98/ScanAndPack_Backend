  created_at   DateTime     @default(now())
  html         String
  subject      String
  template_key String
  vendor       VendorMaster @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@unique([vendor_id, template_key])
  @@index([vendor_id])
}

model Notification {
  id           Int                        @id @default(autoincrement())
  vendor_id    Int
  user_id      Int
  sender_id    Int?
  type         NotificationType
  title        String
  message      String
  entity_type  String?
  entity_id    Int?
  redirect_url String?
  is_read      Boolean                    @default(false)
  read_at      DateTime?
  created_at   DateTime                   @default(now())
  sender       UserMaster?                @relation("NotificationSender", fields: [sender_id], references: [id])
  user         UserMaster                 @relation("NotificationUser", fields: [user_id], references: [id])
  vendor       VendorMaster               @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  deliveryLogs NotificationDeliveryLogs[]

  @@index([user_id, is_read])
  @@index([vendor_id])
}

model UserPushToken {
  id           Int                        @id @default(autoincrement())
  user_id      Int
  vendor_id    Int
  token        String                     @unique
  platform     String
  browser      String?
  is_active    Boolean                    @default(true)
  created_at   DateTime                   @default(now())
  last_used_at DateTime?                  @map("last_used")
  device_id    String?
  deliveryLogs NotificationDeliveryLogs[]
  user         UserMaster                 @relation(fields: [user_id], references: [id])
  vendor       VendorMaster               @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@index([user_id, vendor_id])
}

model NotificationDeliveryLogs {
  id              Int           @id @default(autoincrement())
  notification_id Int
  push_token_id   Int
  status          String
  error           String?
  created_at      DateTime      @default(now())
  notification    Notification  @relation(fields: [notification_id], references: [id])
  pushToken       UserPushToken @relation(fields: [push_token_id], references: [id])
}

model VloqEmailLogs {
  id            Int      @id @default(autoincrement())
  name          String
  email         String
  subject       String
  message       String
  to_email      String
  status        String   @default("pending")
  error_message String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model ModulesMaster {
  id                    Int                    @id @default(autoincrement())
  module_name           String
  module_code           String                 @unique
  active                ActiveStatus           @default(Yes)
  vendorModulesMappings VendorModulesMapping[]
}

model VendorModulesMapping {
  id         Int                              @id @default(autoincrement())
  vendor_id  Int
  module_id  Int
  created_at DateTime                         @default(now())
  created_by Int
  updated_by Int?
  updated_at DateTime?
  active     ModulesVendorMappingActiveStatus @default(Yes)
  module     ModulesMaster                    @relation(fields: [module_id], references: [id])
  vendor     VendorMaster                     @relation(fields: [vendor_id], references: [id])
}

model MachineMaster {
  id                    Int                     @id @default(autoincrement())
  machine_name          String
  machine_code          String                  @unique
  machine_type          String?
  machine_type_id       Int?
  machineType           MachineTypeMaster? @relation(fields: [machine_type_id], references: [id])


  status                MachineStatus           @default(ACTIVE)
  scan_type             ScanType
  description           String?
  vendor_id             Int
  factory_id            Int?
  sequence_no           Int?
  target_per_hour       Decimal?
  image_path            String?
  created_by            Int
  created_at            DateTime                @default(now())
  updated_at            DateTime                @default(now())
  updated_by            Int
  cutListMachineMapping CutListMachineMapping[]
  vendor                VendorMaster            @relation(fields: [vendor_id], references: [id])  
  userMachineMappings UserMachineMapping[]
  defectedItems DefectedItem[]


}


model CutList {
  id                    Int                     @id @default(autoincrement())
  project_id            Int
  vendor_id             Int
  lead_id               Int?                     
  description           String
  length                Decimal?                @db.Decimal(18, 2)
  width                 Decimal?                @db.Decimal(18, 2)
  thickness             Decimal?                @db.Decimal(18, 2)
  qty                   Int
  material_details      String
  item_name             String
  unique_code           String?
  unique_code_2         String?
  status                String                  @default("active")
  created_by            Int
  created_at            DateTime                @default(now())
  updated_by            Int?
  updated_at            DateTime                @default(now())
  elf                   String?
  elb                   String?
  esl                   String?
  esr                   String?
  project               ProjectMaster           @relation(fields: [project_id], references: [id])
  vendor                VendorMaster            @relation(fields: [vendor_id], references: [id])
  
  lead                  LeadMaster?              @relation(fields: [lead_id], references: [id])
  cutListMachineMapping CutListMachineMapping[]
  defectedItems DefectedItem[]
  
}

model CutListMachineMapping {
  id            Int           @id @default(autoincrement())
  cut_list_id   Int
  machine_id    Int
  vendor_id     Int
  lead_id       Int?
  project_id    Int
  sequence_no   Int
  is_optional   Boolean       @default(false)
  expected_in   Boolean       @default(false)
  expected_out  Boolean       @default(false)
  status        String
  actual_in_at  DateTime?
  actual_out_at DateTime?
  in_operator   Int?
  out_operator  Int?
  created_by    Int
  created_at    DateTime      @default(now())
  cut_list      CutList       @relation(fields: [cut_list_id], references: [id])
  machine       MachineMaster @relation(fields: [machine_id], references: [id])
  project       ProjectMaster @relation(fields: [project_id], references: [id])
  vendor        VendorMaster  @relation(fields: [vendor_id], references: [id])  
  lead          LeadMaster?    @relation(fields: [lead_id], references: [id])
  operator      UserMaster?    @relation(fields: [in_operator], references: [id])
  defectedItems DefectedItem[]

  @@index([cut_list_id])
  @@index([machine_id])
  @@index([project_id])
  @@index([vendor_id])
  @@index([sequence_no])
}


model UserMachineMapping {
  id          Int               @id @default(autoincrement())

  user_id     Int
  machine_id  Int
  vendor_id   Int

  status      UserMachineStatus @default(ACTIVE)

  created_by  Int
  created_at  DateTime          @default(now())

  updated_by  Int
  updated_at  DateTime          @default(now())

  // Relations
  user        UserMaster        @relation("UserMachine_user", fields: [user_id], references: [id])
  machine     MachineMaster     @relation(fields: [machine_id], references: [id])

  createdBy   UserMaster        @relation("UserMachine_createdBy", fields: [created_by], references: [id])
  updatedBy   UserMaster        @relation("UserMachine_updatedBy", fields: [updated_by], references: [id])
  vendor      VendorMaster      @relation(fields: [vendor_id], references: [id])


}


model OrderLoginPoFileMapping {
  id             Int            @id @default(autoincrement())

  orderlogin_id  Int
  lead_id        Int
  document_id    Int

  created_by     Int
  created_at     DateTime       @default(now())

  deleted_at     DateTime?
  deleted_by     Int?
  is_deleted     Boolean        @default(false)

  // ================= RELATIONS =================

  orderLogin     OrderLoginDetails @relation(fields: [orderlogin_id], references: [id], onDelete: Cascade)
  lead           LeadMaster        @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  document       LeadDocuments     @relation(fields: [document_id], references: [id], onDelete: Cascade)
  createdBy      UserMaster        @relation("OrderLoginPoFileCreatedBy", fields: [created_by], references: [id], onDelete: Cascade)
  deletedBy      UserMaster?       @relation("OrderLoginPoFileDeletedBy", fields: [deleted_by], references: [id])

  @@index([orderlogin_id])
  @@index([lead_id])
  @@index([document_id])
}

model MachineTypeMaster {
  id           Int            @id @default(autoincrement())
  machine_type String
  active       MachineTypeMasterStatus @default(YES)

  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  machineMaster     MachineMaster[]
  
}


model VendorSettingKey {
  id            Int      @id @default(autoincrement())
  key           String   @unique
  display_name  String
  default_value String?

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  vendorSettings VendorSetting[]
}

model VendorSetting {
  id          Int      @id @default(autoincrement())

  setting_id  Int
  vendor_id   Int
  value       String?

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt


  vendorSettingKey     VendorSettingKey @relation(fields: [setting_id], references: [id])
  vendor      VendorMaster     @relation(fields: [vendor_id], references: [id])

  @@unique([setting_id, vendor_id])
}

model DefectMaster {
  id          Int     @id @default(autoincrement())
  defect_name String

  vendor_id   Int?    

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // ================= RELATIONS =================
  vendorMaster      VendorMaster? @relation(fields: [vendor_id], references: [id])
  defectedItems DefectedItem[]

  @@index([vendor_id])
}


model DefectedItem {
  id          Int      @id @default(autoincrement())

  vendor_id   Int
  project_id  Int
  cut_list_machine_mapping_id Int
  cut_list_id Int?
  machine_id  Int
  defect_id   Int?

  previous_scanned_by Int?
  previous_scanned_at DateTime?
  previous_scanned_machine_id Int?

  remark      String?

  created_by  Int
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  // ================= RELATIONS =================

  vendor      VendorMaster   @relation(fields: [vendor_id], references: [id])
  project     ProjectMaster  @relation(fields: [project_id], references: [id])
  cutListMachineMapping CutListMachineMapping @relation(fields: [cut_list_machine_mapping_id], references: [id])
  cutList     CutList?       @relation(fields: [cut_list_id], references: [id])
  machine     MachineMaster  @relation(fields: [machine_id], references: [id])
  defect      DefectMaster?   @relation(fields: [defect_id], references: [id])
  createdBy   UserMaster     @relation(fields: [created_by], references: [id])

  @@index([vendor_id])
  @@index([project_id])
  @@index([machine_id])
  @@index([cut_list_machine_mapping_id])
  @@index([cut_list_id])
}

