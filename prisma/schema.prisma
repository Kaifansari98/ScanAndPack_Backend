generator client {
  provider = "prisma-client"
  output   = "../generated/prisma_client"
}

datasource db {
  provider = "postgresql"
}

model VendorMaster {
  id                                     Int                                    @id @default(autoincrement())
  vendor_name                            String
  vendor_code                            String
  primary_contact_number                 String
  primary_contact_email                  String
  primary_contact_name                   String
  country_code                           String
  head_office_id                         Int?
  status                                 String                                 @default("inactive")
  logo                                   String
  time_zone                              String
  createdAt                              DateTime                               @default(now())
  updatedAt                              DateTime                               @updatedAt
  vendor_report_code                     String?                                @map("vendor-report-code")
  IsAccountLocInEnabled                  Boolean?                               @default(false)
  state_id                               Int?
  eligible_booking_days                  Int?
  is_approval_task_enabled               Boolean                                @default(true)
  is_client_visit_enabled                Boolean                                @default(true)
  is_crm_enabled                         Boolean                                @default(true)
  is_custom_doc_nomenclature_enabled     Boolean                                @default(false)
  is_inventory_enabled                   Boolean                                @default(false)
  is_self_assign_task_type_master_enabed Boolean                                @default(true)
  is_this_vendor_is_custom_usertype_only Boolean?
  is_tracktrace_enabled                  Boolean                                @default(false)
  is_year_wise_lead_code_enabled         Boolean                                @default(false)
  subdomain_url                          String?
  handlesLargeScaleProjects              Boolean                                @default(false)
  icon                                   String?
  is_email_noti_enabled                  Boolean                                @default(true)
  is_in_app_noti_enabled                 Boolean                                @default(true)
  login_image                            String?
  address                                String?
  city                                   String?
  gst_no                                 String?
  pincode                                String?
  tag_line                               String?
  toll_free_no                           String?
  website_link                           String?
  is_broadcast_enabled                   Boolean                                @default(false)
  is_scanpack_enabled                    Boolean                                @default(false)
  accounts                               AccountMaster[]
  additionalCostMasters                  AdditionalCostMaster[]                 @relation("AdditionalCostVendor")
  architechuremasters                    Architechuremaster[]
  box_info_values                        BoxInfoFieldValue[]
  boxes                                  BoxMaster[]
  brands                                 BrandMaster[]
  broadcastCategories                    BroadcastCategoryMaster[]              @relation("VendorBroadcastCategories")
  broadcasts                             BroadcastMaster[]                      @relation("VendorBroadcasts")
  carcasMaterials                        CarcasMaterialMaster[]
  carcassLegs                            CarcassLegsMaster[]
  carcassTypes                           CarcassTypeMaster[]
  clients                                ClientMaster[]
  clientTypes                            ClientTypeMaster[]
  CompanyVendorsMaster                   CompanyVendorsMaster[]
  CutList                                CutList[]
  cutListMachineMapping                  CutListMachineMapping[]
  debitCreditNotes                       DebitCreditNote[]                      @relation("DCNVendor")
  completionPhotos                       DefectCompletionPhoto[]
  defectMaster                           DefectMaster[]
  defectedItems                          DefectedItem[]
  documentTypes                          DocumentTypeMaster[]
  notificationMasters                    EmailNotificationMaster[]
  externalPlatformTokens                 ExternalPlatformToken[]
  fastProductionRequests                 FastProductionRequest[]
  fastProductionRequestBatches           FastProductionRequestBatch[]
  franchises                             FranchiseMaster[]
  grns                                   GRNMaster[]                            @relation("GRNVendor")
  handleTypes                            HandleTypeMaster[]
  headSiteSupervisorFranchiseMappings    HeadSiteSupervisorFranchiseMapping[]
  hsnMappings                            HsnProductMapping[]                    @relation("HsnVendor")
  installationIssueLogMaster             InstallationIssueLogMaster[]
  installationUpdates                    InstallationUpdate[]
  installationUpdateDocs                 InstallationUpdateDocuments[]
  installerMappings                      InstallerUserMapping[]
  installers                             InstallerUserMaster[]
  issueLogTypeMaster                     IssueLogTypeMaster[]
  itemGroups                             ItemGroupMaster[]
  leadActivityStatusLog                  LeadActivityStatusLog[]
  leadAmcContracts                       LeadAmcContract[]
  leadApprovalRequestDocumentMappings    LeadApprovalRequestDocumentMapping[]
  leadCarcassMaterialMappings            LeadCarcassMaterialMapping[]
  leadChatDocuments                      LeadChatDocument[]
  leadChatRooms                          LeadChatRoom[]
  clientVisits                           LeadClientVisit[]
  clientVisitDocumentMappings            LeadClientVisitDocumentMapping[]
  designMeeting                          LeadDesignMeeting[]
  designMeetingDocsMapping               LeadDesignMeetingDocumentsMapping[]
  designSelection                        LeadDesignSelection[]
  leadDetailedLogs                       LeadDetailedLogs[]
  leadDocumentLogs                       LeadDocumentLogs[]
  documents                              LeadDocuments[]
  leadExternalPlatformCustomerMappings   LeadExternalPlatformCustomerMapping[]
  leadHardwareMappings                   LeadHardwareMapping[]
  leadLightCarcasUnitMappings            LeadLightCarcasUnitMapping[]
  leads                                  LeadMaster[]
  leadOtherAppliancesMappings            LeadOtherAppliancesMapping[]
  leadOtherAppliancesRemarkMappings      LeadOtherAppliancesRemarkMapping[]
  leadProductMaps                        LeadProductMapping[]
  productStructureInstances              LeadProductStructureInstance[]
  leadProductStructureMapping            LeadProductStructureMapping[]
  leadServiceSchedules                   LeadServiceSchedule[]
  leadShutterMaterialMappings            LeadShutterMaterialMapping[]
  siteSupervisors                        LeadSiteSupervisorMapping[]
  leadSpecifications                     LeadSpecificationsMaster[]
  leadStatusLogs                         LeadStatusLogs[]
  leadSuperAdminApprovalLocIns           LeadSuperAdminApprovalLocIns[]
  leadUserMappings                       LeadUserMapping[]
  ledgers                                Ledger[]
  lightCarcasTypes                       LightCarcasTypeMaster[]
  lightCarcasUnits                       LightCarcasUnitMaster[]
  machineMaster                          MachineMaster[]
  meetingTypes                           MeetingTypeMaster[]
  miscellaneousDocument                  MiscellaneousDocument[]
  miscellaneousMaster                    MiscellaneousMaster[]
  miscellaneousTeamMaster                MiscellaneousTeamMaster[]
  miscellaneousTypeMaster                MiscellaneousTypeMaster[]
  notifications                          Notification[]
  orderLoginDetails                      OrderLoginDetails[]
  otherAppliances                        OtherAppliancesMaster[]
  poPayments                             POPayment[]
  poPaymentSchedules                     POPaymentSchedule[]
  popaymentScheduleHistories             POPaymentScheduleHistory[]
  payments                               PaymentInfo[]
  paymentTerms                           PaymentTermMaster[]
  paymentTypeMaster                      PaymentTypeMaster[]
  privilegeMasters                       PrivilegeMaster[]
  productItemCodes                       ProductItemCode[]
  products                               ProductMaster[]
  stockHistories                         ProductStockHistory[]                  @relation("StockHistoryVendor")
  productStructure                       ProductStructure[]
  productSubStructures                   ProductSubStructure[]
  productSupplierMappings                ProductSupplierMapping[]
  productTypes                           ProductTypeMaster[]
  box_info_fields                        ProjectBoxInfoField[]
  projectCategoriesMaster                ProjectCategoriesMaster[]
  projectCategoriesVendorMappings        ProjectCategoriesMasterVendorMapping[]
  projectDetails                         ProjectDetails[]
  projectItems                           ProjectItemsMaster[]
  projects                               ProjectMaster[]
  purchaseIntents                        PurchaseIntentMaster[]                 @relation("PIVendor")
  piSupplierAdditionalCosts              PurchaseIntentSupplierAdditionalCost[] @relation("PISupplierAdditionalCostVendor")
  purchaseOrders                         PurchaseOrderMaster[]                  @relation("POVendor")
  poSupplierAdditionalCosts              PurchaseOrderSupplierAdditionalCost[]  @relation("POSupplierAdditionalCostVendor")
  redeliveryRequests                     RedeliveryRequest[]                    @relation("RDVendor")
  scanItems                              ScanAndPackItem[]
  selfAssignTaskTypeMasters              SelfAssignTaskTypeMaster[]
  shutterMaterials                       ShutterMaterialMaster[]
  shutterTypes                           ShutterTypeMaster[]
  siteReadiness                          SiteReadiness[]
  siteTypes                              SiteTypeMaster[]
  sources                                SourceMaster[]
  statusTypes                            StatusTypeMaster[]
  themes                                 ThemeMaster[]
  timelineRules                          TimelineRule[]
  units                                  UnitMaster[]
  userLeadTasks                          UserLeadTask[]
  userMachineMapping                     UserMachineMapping[]
  users                                  UserMaster[]
  userPrivilegeMappings                  UserPrivilegeMapping[]
  userPushTokens                         UserPushToken[]
  userSessions                           UserSession[]
  addresses                              VendorAddress[]
  state                                  StateMaster?                           @relation("VendorState", fields: [state_id], references: [id])
  vendorModulesMappings                  VendorModulesMapping[]
  vendorSetting                          VendorSetting[]
  taxInfo                                VendorTaxInfo[]
  tokens                                 VendorTokens[]
  chsSelectionMappings                   CHSSelectionTypeMapping[]
  smallOrderRequests                     SmallOrderRequest[]
  smallOrderRequestDocuments             SmallOrderRequestDocument[]
  smallOrderRequestTypeMasters           SmallOrderRequestTypeMaster[]
  specificationDocumentMappings          specificationDocumentMapping[]

  @@index([state_id])
}

model VendorAddress {
  id        Int          @id @default(autoincrement())
  vendor_id Int
  address   String
  state     String
  city      String
  country   String
  pincode   String
  landmark  String
  vendor    VendorMaster @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
}

model VendorTaxInfo {
  id          Int          @id @default(autoincrement())
  tax_no      String
  tax_status  String
  vendor_id   Int
  tax_country String
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  vendor      VendorMaster @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
}

model UserTypeMaster {
  id                        Int                        @id @default(autoincrement())
  user_type                 String
  selfAssignTaskTypeMasters SelfAssignTaskTypeMaster[]
  users                     UserMaster[]
}

model PrivilegeMaster {
  id                    Int                    @id @default(autoincrement())
  vendor_id             Int
  code                  String
  parent_module         String
  child_module          String
  action                String
  label                 String
  description           String?
  is_active             Boolean                @default(true)
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  vendor                VendorMaster           @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  userPrivilegeMappings UserPrivilegeMapping[]

  @@unique([vendor_id, code])
  @@index([vendor_id])
}

model UserMaster {
