model UserDocument {
  id              Int        @id @default(autoincrement())
  user_id         Int
  document_name   String
  document_number String
  filename        String
  user            UserMaster @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model UserSession {
  id                 Int                  @id @default(autoincrement())
  user_id            Int
  vendor_id          Int
  refresh_token_hash String
  access_jti         String?              @unique
  device_id          String?
  device_name        String?
  platform           String?
  ip_address         String?
  user_agent         String?
  login_type         UserSessionLoginType @default(USER_LOGIN)
  status             UserSessionStatus    @default(active)
  is_current         Boolean?             @default(true)
  last_seen_at       DateTime?            @default(now())
  expires_at         DateTime
  logged_out_at      DateTime?
  revoked_at         DateTime?
  revoked_by         Int?
  revoke_reason      String?
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  revokedBy          UserMaster?          @relation("UserSessionRevokedBy", fields: [revoked_by], references: [id])
  user               UserMaster           @relation("UserSessions", fields: [user_id], references: [id], onDelete: Cascade)
  vendor             VendorMaster         @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
  @@index([user_id, created_at])
  @@index([vendor_id, status])
  @@index([device_id])
}

model UserPrivilegeMapping {
  id           Int             @id @default(autoincrement())
  vendor_id    Int
  user_id      Int
  privilege_id Int
  is_allowed   Boolean         @default(false)
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt
  privilege    PrivilegeMaster @relation(fields: [privilege_id], references: [id], onDelete: Cascade)
  user         UserMaster      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  vendor       VendorMaster    @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@unique([vendor_id, user_id, privilege_id])
  @@index([vendor_id])
  @@index([user_id])
  @@index([privilege_id])
}

model ProjectMaster {
  id                    Int                     @id @default(autoincrement())
  project_name          String
  vendor_id             Int
  client_id             Int?
  created_by            Int
  project_status        String                  @default("Initiated")
  created_at            DateTime                @default(now())
  unique_project_id     String
  is_grouping           Boolean                 @default(false)
  track_trace_status    String                  @default("Not Started")
  lead_id               Int?
  track_completed_at    DateTime?
  track_started_at      DateTime?
  client_address        String?
  client_contact_no     String?
  client_name           String?
  order_no              String?
  updated_at            DateTime?               @updatedAt
  updated_by            Int?
  packing_type          PackingType             @default(DEFAULT)
  box_info_values       BoxInfoFieldValue[]
  boxes                 BoxMaster[]
  CutList               CutList[]
  cutListMachineMapping CutListMachineMapping[]
  defectedItems         DefectedItem[]
  box_info_fields       ProjectBoxInfoField[]
  details               ProjectDetails[]
  items                 ProjectItemsMaster[]
  client                ClientMaster?           @relation(fields: [client_id], references: [id], onDelete: Cascade)
  createdByUser         UserMaster              @relation("CreatedByUser", fields: [created_by], references: [id], onDelete: Cascade)
  lead                  LeadMaster?             @relation(fields: [lead_id], references: [id])
  vendor                VendorMaster            @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  scanItems             ScanAndPackItem[]
}

model ProjectDetails {
  id                        Int                  @id @default(autoincrement())
  project_id                Int
  vendor_id                 Int
  total_items               Int                  @default(0)
  total_packed              Int                  @default(0)
  total_unpacked            Int                  @default(0)
  actual_completion_date    DateTime?
  estimated_completion_date DateTime?
  start_date                DateTime             @default(now())
  is_grouping               Boolean              @default(false)
  room_name                 String
  lead_id                   Int?
  boxes                     BoxMaster[]          @relation("BoxDetails")
  leadMaster                LeadMaster?          @relation(fields: [lead_id], references: [id])
  project                   ProjectMaster        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  vendor                    VendorMaster         @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  items                     ProjectItemsMaster[]
  scanItems                 ScanAndPackItem[]    @relation("ItemDetails")
}

model ProjectItemsMaster {
  id                 Int            @id @default(autoincrement())
  project_id         Int
  vendor_id          Int
  category           String
  unique_id          String
  item_name          String
  L1                 String
  L2                 String
  L3                 String
  qty                Int
  project_details_id Int
  group              String
  weight             Float          @default(0)
  details            ProjectDetails @relation(fields: [project_details_id], references: [id], onDelete: Cascade)
  project            ProjectMaster  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  vendor             VendorMaster   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
}

model BoxMaster {
  id                    Int                     @id @default(autoincrement())
  project_id            Int
  vendor_id             Int
  box_name              String
  box_status            BoxStatus
  created_by            Int
  created_date          DateTime                @default(now())
