  deleted_at    DateTime?                      @map("deleted_at")
  deleted_by    Int?                           @map("deleted_by")
  is_deleted    Boolean                        @default(false) @map("is_deleted")
  docMappings   CompanyVendorDocumentMapping[]

  @@map("CompanyVendorDocumentMaster")
}

model CompanyVendorDocumentMapping {
  id                Int                         @id @default(autoincrement()) @map("document_id")
  company_vendor_id Int                         @map("company_vendor_id")
  document_type_id  Int                         @map("document_type_id")
  file_path         String                      @map("file_path")
  created_at        DateTime                    @default(now()) @map("created_at")
  created_by        Int                         @map("created_by")
  updated_at        DateTime                    @updatedAt @map("updated_at")
  updated_by        Int                         @map("updated_by")
  deleted_at        DateTime?                   @map("deleted_at")
  deleted_by        Int?                        @map("deleted_by")
  is_deleted        Boolean                     @default(false) @map("is_deleted")
  companyVendor     CompanyVendorsMaster        @relation(fields: [company_vendor_id], references: [id], onDelete: Cascade)
  documentType      CompanyVendorDocumentMaster @relation(fields: [document_type_id], references: [id], onDelete: Cascade)

  @@map("CompanyVendorDocumentMapping")
}

model CompanyVendorAddress {
  id                Int                  @id @default(autoincrement()) @map("address_id")
  company_vendor_id Int                  @map("company_vendor_id")
  address_line_1    String               @map("address_line_1")
  address_line_2    String?              @map("address_line_2")
  landmark          String?              @map("landmark")
  pincode           String               @map("pincode")
  state_id          Int                  @map("state_id")
  city_id           Int                  @map("city_id")
  is_primary        Boolean              @default(false) @map("is_primary")
  created_at        DateTime             @default(now()) @map("created_at")
  created_by        Int                  @map("created_by")
  updated_at        DateTime             @updatedAt @map("updated_at")
  updated_by        Int                  @map("updated_by")
  deleted_at        DateTime?            @map("deleted_at")
  deleted_by        Int?                 @map("deleted_by")
  is_deleted        Boolean              @default(false) @map("is_deleted")
  city              CityMaster           @relation("CompanyVendorAddressCity", fields: [city_id], references: [id])
  companyVendor     CompanyVendorsMaster @relation(fields: [company_vendor_id], references: [id], onDelete: Cascade)
  state             StateMaster          @relation("CompanyVendorAddressState", fields: [state_id], references: [id])

  @@map("CompanyVendorAddress")
}

model BroadcastMaster {
  id          Int                        @id @default(autoincrement())
  title       String
  content     String
  status      BroadcastStatus            @default(ACTIVE)
  type        BroadcastType
  publish_at  DateTime?
  vendor_id   Int?
  created_by  Int
  updated_by  Int?
  created_at  DateTime                   @default(now())
  updated_at  DateTime                   @updatedAt
  category_id Int?
  attachments BroadcastAttachment[]
  audiences   BroadcastAudienceMapping[]
  category    BroadcastCategoryMaster?   @relation("BroadcastCategory", fields: [category_id], references: [id])
  createdBy   UserMaster                 @relation("BroadcastCreatedBy", fields: [created_by], references: [id])
  updatedBy   UserMaster?                @relation("BroadcastUpdatedBy", fields: [updated_by], references: [id])
  vendor      VendorMaster?              @relation("VendorBroadcasts", fields: [vendor_id], references: [id])
  readLogs    BroadcastRead[]

  @@index([vendor_id])
  @@index([category_id])
  @@index([created_by])
  @@index([updated_by])
}

model BroadcastCategoryMaster {
  id         Int               @id @default(autoincrement())
  category   String
  type       String
  vendor_id  Int
  is_active  Boolean           @default(true)
  created_by Int
  created_at DateTime          @default(now())
  createdBy  UserMaster        @relation("BroadcastCategoryCreatedBy", fields: [created_by], references: [id])
  vendor     VendorMaster      @relation("VendorBroadcastCategories", fields: [vendor_id], references: [id], onDelete: Cascade)
  broadcasts BroadcastMaster[] @relation("BroadcastCategory")

  @@index([vendor_id])
}

model BroadcastAudienceMapping {
  id            Int             @id @default(autoincrement())
  broadcast_id  Int
  audience_type AudienceType
  target_id     Int?
  created_by    Int
  updated_by    Int?
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  broadcast     BroadcastMaster @relation(fields: [broadcast_id], references: [id], onDelete: Cascade)
  createdBy     UserMaster      @relation("BroadcastAudienceCreatedBy", fields: [created_by], references: [id])
  updatedBy     UserMaster?     @relation("BroadcastAudienceUpdatedBy", fields: [updated_by], references: [id])

  @@index([broadcast_id])
  @@index([audience_type, target_id])
}

model BroadcastAttachment {
  id                 Int             @id @default(autoincrement())
  broadcast_id       Int
  attachment_type    AttachmentType
  title              String
  file_name          String?
  original_file_name String?
  file_url           String
  file_type          String?
  file_size          BigInt?
  created_by         Int
  updated_by         Int?
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  broadcast          BroadcastMaster @relation(fields: [broadcast_id], references: [id], onDelete: Cascade)
  createdBy          UserMaster      @relation("BroadcastAttachmentCreatedBy", fields: [created_by], references: [id])
  updatedBy          UserMaster?     @relation("BroadcastAttachmentUpdatedBy", fields: [updated_by], references: [id])

  @@index([broadcast_id])
  @@index([created_by])
  @@index([updated_by])
}

model BroadcastRead {
  id           Int             @id @default(autoincrement())
  broadcast_id Int
  user_id      Int
  read_at      DateTime        @default(now())
  created_by   Int
  updated_by   Int?
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt
  broadcast    BroadcastMaster @relation(fields: [broadcast_id], references: [id], onDelete: Cascade)
  createdBy    UserMaster      @relation("BroadcastReadCreatedBy", fields: [created_by], references: [id])
  updatedBy    UserMaster?     @relation("BroadcastReadUpdatedBy", fields: [updated_by], references: [id])
  user         UserMaster      @relation("BroadcastReadUser", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([broadcast_id, user_id])
  @@index([broadcast_id])
  @@index([user_id])
  @@index([created_by])
  @@index([updated_by])
}

model NotificationQueue {
  id                  Int                @id @default(autoincrement())
  title               String
  body                String
  redirect_url        String?
  image               String?
  notification_source NotificationSource
  notification_status NotificationStatus @default(PENDING)
  send_at             DateTime
  request_body        Json?
  created_by          Int
  updated_by          Int?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  createdBy           UserMaster         @relation("NotificationQueueCreatedBy", fields: [created_by], references: [id])
  updatedBy           UserMaster?        @relation("NotificationQueueUpdatedBy", fields: [updated_by], references: [id])

  @@index([created_by])
  @@index([updated_by])
  @@index([notification_status, send_at])
}

