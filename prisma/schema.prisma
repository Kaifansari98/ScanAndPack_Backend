  leadUserCreated                            LeadUserMapping[]                      @relation("LeadUser_CreatedBy")
  leadUserUpdated                            LeadUserMapping[]                      @relation("LeadUser_UpdatedBy")
  leadUserAsUser                             LeadUserMapping[]                      @relation("LeadUser_User")
  ledgersCreated                             Ledger[]
  miscDocumentsCreated                       MiscellaneousDocument[]                @relation("MiscDocCreatedBy")
  miscCreated                                MiscellaneousMaster[]                  @relation("MiscCreatedBy")
  miscUpdated                                MiscellaneousMaster[]                  @relation("MiscUpdatedBy")
  notificationsSent                          Notification[]                         @relation("NotificationSender")
  notificationsReceived                      Notification[]                         @relation("NotificationUser")
  notificationQueuesCreated                  NotificationQueue[]                    @relation("NotificationQueueCreatedBy")
  notificationQueuesUpdated                  NotificationQueue[]                    @relation("NotificationQueueUpdatedBy")
  orderLoginDetails                          OrderLoginDetails[]
  orderLoginsUpdated                         OrderLoginDetails[]                    @relation("OrderLoginUpdatedBy")
  orderLoginPoFilesCreated                   OrderLoginPoFileMapping[]              @relation("OrderLoginPoFileCreatedBy")
  orderLoginPoFilesDeleted                   OrderLoginPoFileMapping[]              @relation("OrderLoginPoFileDeletedBy")
  poPaymentScheduleHistories                 POPaymentScheduleHistory[]
  paymentsCreated                            PaymentInfo[]
  stockHistories                             ProductStockHistory[]                  @relation("StockHistoryUser")
  projectCategoriesVendorMappingsCreated     ProjectCategoriesMasterVendorMapping[] @relation("ProjectCategoriesVendorMapping_createdBy")
  projectCategoriesVendorMappingsUpdated     ProjectCategoriesMasterVendorMapping[] @relation("ProjectCategoriesVendorMapping_updatedBy")
  createdProjects                            ProjectMaster[]                        @relation("CreatedByUser")
  purchaseIntentsApproved                    PurchaseIntentMaster[]                 @relation("PIApprovedBy")
  purchaseIntentsCreated                     PurchaseIntentMaster[]                 @relation("PICreatedBy")
  purchaseIntentsDeleted                     PurchaseIntentMaster[]                 @relation("PIDeletedBy")
  purchaseIntentsRejected                    PurchaseIntentMaster[]                 @relation("PIRejectedBy")
  purchaseIntentsUpdated                     PurchaseIntentMaster[]                 @relation("PIUpdatedBy")
  purchaseIntentStatusLogs                   PurchaseIntentStatusLog[]              @relation("PIStatusLogChangedBy")
  poItemsCreated                             PurchaseOrderItem[]                    @relation("POItemCreatedBy")
  poItemsDeleted                             PurchaseOrderItem[]                    @relation("POItemDeletedBy")
  poItemsUpdated                             PurchaseOrderItem[]                    @relation("POItemUpdatedBy")
  purchaseOrdersCreated                      PurchaseOrderMaster[]                  @relation("POCreatedBy")
  purchaseOrdersUpdated                      PurchaseOrderMaster[]                  @relation("POUpdatedBy")
  redeliveriesCreated                        RedeliveryRequest[]                    @relation("RDCreatedBy")
  scanItemsCreated                           ScanAndPackItem[]
  siteReadinessCreated                       SiteReadiness[]                        @relation("SiteReadinessCreatedBy")
  siteReadinessUpdated                       SiteReadiness[]                        @relation("SiteReadinessUpdatedBy")
  activityLogs                               UserActivityLog[]
  documents                                  UserDocument[]
  userGeographicalMappings                   UserGeographicalMapping[]
  leadTasksClosed                            UserLeadTask[]                         @relation("LeadTask_ClosedBy")
  leadTasksCreated                           UserLeadTask[]                         @relation("LeadTask_CreatedBy")
  leadTasksAssigned                          UserLeadTask[]                         @relation("LeadTask_User")
  createdUserMachineMappings                 UserMachineMapping[]                   @relation("UserMachine_createdBy")
  updatedUserMachineMappings                 UserMachineMapping[]                   @relation("UserMachine_updatedBy")
  userMachineMappings                        UserMachineMapping[]                   @relation("UserMachine_user")
  franchise                                  FranchiseMaster?                       @relation(fields: [franchise_id], references: [id])
  user_type                                  UserTypeMaster                         @relation(fields: [user_type_id], references: [id])
  vendor                                     VendorMaster                           @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  userPrivilegeMappings                      UserPrivilegeMapping[]
  pushTokens                                 UserPushToken[]
  revokedSessions                            UserSession[]                          @relation("UserSessionRevokedBy")
  sessions                                   UserSession[]                          @relation("UserSessions")
  chsMappingCreatedBy                        CHSSelectionTypeMapping[]              @relation("CHSMappingCreatedBy")
  chsMappingUpdatedBy                        CHSSelectionTypeMapping[]              @relation("CHSMappingUpdatedBy")
