  broadcastsUpdated                          BroadcastMaster[]                      @relation("BroadcastUpdatedBy")
  broadcastReadsCreated                      BroadcastRead[]                        @relation("BroadcastReadCreatedBy")
  broadcastReadsUpdated                      BroadcastRead[]                        @relation("BroadcastReadUpdatedBy")
