model GRNItem {
  id               Int           @id @default(autoincrement())
  grn_id           Int
  po_item_id       Int // links to PurchaseOrderItem
  product_id       Int
  received_qty     Decimal       @db.Decimal(12, 2)
  accepted_qty     Decimal       @db.Decimal(12, 2)
  rejected_qty     Decimal       @default(0) @db.Decimal(12, 2)
  unit_price       Decimal?      @db.Decimal(12, 2)
  uom              String?
  status           GRNItemStatus @default(Accepted)
  rejection_reason String? // why goods were rejected
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  mrp              Decimal?      @db.Decimal(12, 2)
  discount_pct     Decimal?      @db.Decimal(5, 2)
  rate             Decimal?      @db.Decimal(12, 2)
  tax_pct          Decimal?      @db.Decimal(5, 2)
  cgst_pct         Decimal?      @db.Decimal(5, 2)
  sgst_pct         Decimal?      @db.Decimal(5, 2)
  igst_pct         Decimal?      @db.Decimal(5, 2)
  tax_amount       Decimal?      @db.Decimal(12, 2) // tax on accepted qty
  amount           Decimal?      @db.Decimal(12, 2) // rate * accepted_qty
  total_amount     Decimal?      @db.Decimal(12, 2) // amount + tax_amount
  hsn_code         String?
  gst_percentage   Decimal?      @db.Decimal(5, 2)

  taxable_amount Decimal? @db.Decimal(18, 2)

  cgst_percentage Decimal? @db.Decimal(5, 2)
  sgst_percentage Decimal? @db.Decimal(5, 2)
  igst_percentage Decimal? @db.Decimal(5, 2)

  cgst_amount Decimal? @default(0) @db.Decimal(18, 2)
  sgst_amount Decimal? @default(0) @db.Decimal(18, 2)
  igst_amount Decimal? @default(0) @db.Decimal(18, 2)

  discount_percentage Decimal? @default(0) @db.Decimal(5, 2)
  discount_amount     Decimal? @default(0) @db.Decimal(18, 2)

  line_total Decimal? @db.Decimal(18, 2)

  grn     GRNMaster         @relation(fields: [grn_id], references: [id], onDelete: Cascade)
  poItem  PurchaseOrderItem @relation("GRNFromPOItem", fields: [po_item_id], references: [id])
  product ProductMaster     @relation("GRNItemProduct", fields: [product_id], references: [id])

  redeliveryRequests RedeliveryRequest[]

  @@index([grn_id])
  @@index([po_item_id])
  @@index([product_id])
