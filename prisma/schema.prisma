  changedBy      UserMaster           @relation("PIStatusLogChangedBy", fields: [changed_by], references: [id])

  @@index([purchase_intent_id])
}

model PurchaseOrderMaster {
  id                     Int                 @id @default(autoincrement())
  vendor_id              Int
  po_no                  String              @unique // PO-000001
  purchase_intent_id     Int
  company_vendor_id      Int // supplier this PO is for
  status                 PurchaseOrderStatus @default(Draft)
  remarks                String?
  expected_delivery_date DateTime?
  created_by             Int
  updated_by             Int?
  is_deleted             Boolean             @default(false)
  deleted_at             DateTime?
  deleted_by             Int? // who cancelled/deleted
  created_at             DateTime            @default(now())
  updated_at             DateTime            @updatedAt
  amount                 Decimal?            @db.Decimal(18, 2)
  tax_amount             Decimal?            @db.Decimal(18, 2)
  total_amount           Decimal?            @db.Decimal(18, 2)
  payment_term_id        Int?

  vendor         VendorMaster         @relation("POVendor", fields: [vendor_id], references: [id], onDelete: Cascade)
  purchaseIntent PurchaseIntentMaster @relation("POIntent", fields: [purchase_intent_id], references: [id])
  companyVendor  CompanyVendorsMaster @relation("POSupplier", fields: [company_vendor_id], references: [id])
  createdBy      UserMaster           @relation("POCreatedBy", fields: [created_by], references: [id])
  updatedBy      UserMaster?          @relation("POUpdatedBy", fields: [updated_by], references: [id])

  items       PurchaseOrderItem[]
  paymentTerm PaymentTermMaster?  @relation(fields: [payment_term_id], references: [id], onDelete: SetNull)

  paymentSchedules        POPaymentSchedule[]
  grns                    GRNMaster[]                           @relation("GRNPurchaseOrder")
  supplierAdditionalCosts PurchaseOrderSupplierAdditionalCost[] @relation("POSupplierAdditionalCosts")

  @@index([payment_term_id])
  @@index([vendor_id])
  @@index([purchase_intent_id])
  @@index([company_vendor_id])
  @@index([status])
}

model PurchaseOrderItem {
  id                        Int       @id @default(autoincrement())
  purchase_order_id         Int
  product_id                Int
  pi_item_vendor_mapping_id Int? // links back to the PI mapping row
  ordered_qty               Decimal   @db.Decimal(12, 2)
  received_qty              Decimal   @default(0) @db.Decimal(12, 2)
  unit_price                Decimal?  @db.Decimal(12, 2)
  uom                       String?
  expected_delivery_date    DateTime?
  remarks                   String?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt
  created_by                Int?
  updated_by                Int?

  mrp          Decimal?  @db.Decimal(12, 2)
  discount_pct Decimal?  @db.Decimal(5, 2)
  rate         Decimal?  @db.Decimal(12, 2) // editable in PO
  tax_pct      Decimal?  @db.Decimal(5, 2)
  cgst_pct     Decimal?  @db.Decimal(5, 2)
  sgst_pct     Decimal?  @db.Decimal(5, 2)
  igst_pct     Decimal?  @db.Decimal(5, 2)
  tax_amount   Decimal?  @db.Decimal(12, 2)
  amount       Decimal?  @db.Decimal(12, 2) // rate * ordered_qty
  total_amount Decimal?  @db.Decimal(12, 2) // amount + tax_amount
  is_deleted   Boolean   @default(false)
  deleted_at   DateTime?
  deleted_by   Int?

  purchaseOrder   PurchaseOrderMaster              @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)
  product         ProductMaster                    @relation("POItemProduct", fields: [product_id], references: [id])
  piVendorMapping PurchaseIntentItemVendorMapping? @relation("POFromPI", fields: [pi_item_vendor_mapping_id], references: [id])
  createdBy       UserMaster?                      @relation("POItemCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  updatedBy       UserMaster?                      @relation("POItemUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)
  deletedBy       UserMaster?                      @relation("POItemDeletedBy", fields: [deleted_by], references: [id], onDelete: SetNull)
  grnItems        GRNItem[]                        @relation("GRNFromPOItem")

  @@index([purchase_order_id])
  @@index([product_id])
}

model GRNMaster {
  id                Int       @id @default(autoincrement())
  vendor_id         Int
  grn_no            String    @unique // GRN-000001
  purchase_order_id Int
  company_vendor_id Int
  status            GRNStatus @default(Draft)
  received_date     DateTime
  vehicle_no        String?
  gate_entry_no     String?
  invoice_no        String?
  invoice_date      DateTime?
  invoice_amount    Decimal?  @db.Decimal(12, 2)
  remarks           String?
  created_by        Int
  updated_by        Int?
  confirmed_by      Int?
  confirmed_at      DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  subtotal_amount   Decimal?  @db.Decimal(18, 2)

  cgst_amount Decimal? @default(0) @db.Decimal(18, 2)
  sgst_amount Decimal? @default(0) @db.Decimal(18, 2)
  igst_amount Decimal? @default(0) @db.Decimal(18, 2)
  cess_amount Decimal? @default(0) @db.Decimal(18, 2)

  discount_amount      Decimal? @default(0) @db.Decimal(18, 2)
  packing_amount       Decimal? @default(0) @db.Decimal(18, 2)
  freight_amount       Decimal? @default(0) @db.Decimal(18, 2)
  other_charges_amount Decimal? @default(0) @db.Decimal(18, 2)

