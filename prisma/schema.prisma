generator client {
  provider = "prisma-client"
  output   = "../generated/prisma_client"
}

datasource db {
  provider = "postgresql"
}

model VendorMaster {
  id                                     Int      @id @default(autoincrement())
  vendor_name                            String
  vendor_code                            String
  vendor_report_code                     String?  @map("vendor-report-code")
  primary_contact_number                 String
  primary_contact_email                  String
  primary_contact_name                   String
  country_code                           String
  head_office_id                         Int?
  status                                 String   @default("inactive")
  logo                                   String
  icon                                   String?
  login_image                            String?
  time_zone                              String
  subdomain_url                          String?
  IsAccountLocInEnabled                  Boolean? @default(false)
  is_crm_enabled                         Boolean  @default(true)
  is_custom_doc_nomenclature_enabled     Boolean  @default(false)
  is_inventory_enabled                   Boolean  @default(false)
  is_tracktrace_enabled                  Boolean  @default(false)
  is_approval_task_enabled               Boolean  @default(true)
  is_client_visit_enabled                Boolean  @default(true)
  is_this_vendor_is_custom_usertype_only Boolean? // true : only custom user, false : custom user + all the user types and null : no custom user at all.
  is_year_wise_lead_code_enabled         Boolean  @default(false)
  handlesLargeScaleProjects              Boolean  @default(false)
  eligible_booking_days                  Int?
  is_self_assign_task_type_master_enabed Boolean  @default(true)
  is_email_noti_enabled                  Boolean  @default(true)
  is_in_app_noti_enabled                 Boolean  @default(true)
  is_broadcast_enabled                   Boolean  @default(false)
  createdAt                              DateTime @default(now())
  updatedAt                              DateTime @updatedAt
  state_id                               Int?
  gst_no                                 String?
  toll_free_no                           String?
  website_link                           String?
  tag_line                               String?
  address                                String?
  pincode                                String?
  city                                   String?

  accounts                            AccountMaster[]
  boxes                               BoxMaster[]
  CompanyVendorsMaster                CompanyVendorsMaster[]
  CutList                             CutList[]
  cutListMachineMapping               CutListMachineMapping[]
  defectMaster                        DefectMaster[]
  defectedItems                       DefectedItem[]
  documentTypes                       DocumentTypeMaster[]
  notificationMasters                 EmailNotificationMaster[]
  franchises                          FranchiseMaster[]
  headSiteSupervisorFranchiseMappings HeadSiteSupervisorFranchiseMapping[]
  installationIssueLogMaster          InstallationIssueLogMaster[]
  installationUpdates                 InstallationUpdate[]
  installationUpdateDocs              InstallationUpdateDocuments[]
  installerMappings                   InstallerUserMapping[]
  installers                          InstallerUserMaster[]
  issueLogTypeMaster                  IssueLogTypeMaster[]
  carcassTypes                        CarcassTypeMaster[]
  carcasMaterials                     CarcasMaterialMaster[]
  shutterTypes                        ShutterTypeMaster[]
  shutterMaterials                    ShutterMaterialMaster[]
  carcassLegs                         CarcassLegsMaster[]
  leadSpecifications                  LeadSpecificationsMaster[]
  leadCarcassMaterialMappings         LeadCarcassMaterialMapping[]
  leadShutterMaterialMappings         LeadShutterMaterialMapping[]
  leadHardwareMappings                LeadHardwareMapping[]
  lightCarcasTypes                    LightCarcasTypeMaster[]
  lightCarcasUnits                    LightCarcasUnitMaster[]
  leadLightCarcasUnitMappings         LeadLightCarcasUnitMapping[]
  otherAppliances                     OtherAppliancesMaster[]
  leadOtherAppliancesMappings         LeadOtherAppliancesMapping[]
  specificationDocumentMappings       specificationDocumentMapping[]
  handleTypes                         HandleTypeMaster[]
  timelineRules                       TimelineRule[]
  leadActivityStatusLog               LeadActivityStatusLog[]
  leadChatDocuments                   LeadChatDocument[]
  leadChatRooms                       LeadChatRoom[]
  designMeeting                       LeadDesignMeeting[]
  clientVisits                        LeadClientVisit[]
  meetingTypes                        MeetingTypeMaster[]
  designMeetingDocsMapping            LeadDesignMeetingDocumentsMapping[]
  clientVisitDocumentMappings         LeadClientVisitDocumentMapping[]
  designSelection                     LeadDesignSelection[]
  chsSelectionMappings                CHSSelectionTypeMapping[]
  leadDetailedLogs                    LeadDetailedLogs[]
  leadApprovalRequestDocumentMappings LeadApprovalRequestDocumentMapping[]
  leadDocumentLogs                    LeadDocumentLogs[]
  documents                           LeadDocuments[]
  leads                               LeadMaster[]
  leadAmcContracts                    LeadAmcContract[]
  leadSuperAdminApprovalLocIns        LeadSuperAdminApprovalLocIns[]
  leadProductMaps                     LeadProductMapping[]
  productStructureInstances           LeadProductStructureInstance[]
  leadProductStructureMapping         LeadProductStructureMapping[]
  leadServiceSchedules                LeadServiceSchedule[]
  siteSupervisors                     LeadSiteSupervisorMapping[]
  leadStatusLogs                      LeadStatusLogs[]
  leadUserMappings                    LeadUserMapping[]
  ledgers                             Ledger[]
  machineMaster                       MachineMaster[]
  miscellaneousDocument               MiscellaneousDocument[]
  miscellaneousMaster                 MiscellaneousMaster[]
  miscellaneousTeamMaster             MiscellaneousTeamMaster[]
  miscellaneousTypeMaster             MiscellaneousTypeMaster[]
  notifications                       Notification[]
  orderLoginDetails                   OrderLoginDetails[]
  payments                            PaymentInfo[]
  paymentTypeMaster                   PaymentTypeMaster[]
  productStructure                    ProductStructure[]
  productSubStructures                ProductSubStructure[]
  productItemCodes                    ProductItemCode[]
  productTypes                        ProductTypeMaster[]
  smallOrderRequests                  SmallOrderRequest[]
  smallOrderRequestTypeMasters        SmallOrderRequestTypeMaster[]
  smallOrderRequestDocuments          SmallOrderRequestDocument[]
  projectDetails                      ProjectDetails[]
  projectItems                        ProjectItemsMaster[]
  projects                            ProjectMaster[]
  scanItems                           ScanAndPackItem[]
  siteReadiness                       SiteReadiness[]
  siteTypes                           SiteTypeMaster[]
  sources                             SourceMaster[]
  statusTypes                         StatusTypeMaster[]
  themes                              ThemeMaster[]
  userLeadTasks                       UserLeadTask[]
  userMachineMapping                  UserMachineMapping[]
  privilegeMasters                    PrivilegeMaster[]
  userPrivilegeMappings               UserPrivilegeMapping[]
  users                               UserMaster[]
  userSessions                        UserSession[]
  userPushTokens                      UserPushToken[]
  addresses                           VendorAddress[]
  vendorModulesMappings               VendorModulesMapping[]
  vendorSetting                       VendorSetting[]
  selfAssignTaskTypeMasters           SelfAssignTaskTypeMaster[]
  taxInfo                             VendorTaxInfo[]
  tokens                              VendorTokens[]
  externalPlatformTokens              ExternalPlatformToken[]
  fastProductionRequests              FastProductionRequest[]
  fastProductionRequestBatches        FastProductionRequestBatch[]

  completionPhotos                     DefectCompletionPhoto[]
  leadExternalPlatformCustomerMappings LeadExternalPlatformCustomerMapping[]
  projectCategoriesMaster              ProjectCategoriesMaster[]
  projectCategoriesVendorMappings      ProjectCategoriesMasterVendorMapping[]
  brands                               BrandMaster[]
  products                             ProductMaster[]
  purchaseIntents                      PurchaseIntentMaster[]                 @relation("PIVendor")
  purchaseOrders                       PurchaseOrderMaster[]                  @relation("POVendor")
  grns                                 GRNMaster[]                            @relation("GRNVendor")
  debitCreditNotes                     DebitCreditNote[]                      @relation("DCNVendor")
  redeliveryRequests                   RedeliveryRequest[]                    @relation("RDVendor")
  hsnMappings                          HsnProductMapping[]                    @relation("HsnVendor")
  state                                StateMaster?                           @relation("VendorState", fields: [state_id], references: [id], onDelete: SetNull)
  stockHistories                       ProductStockHistory[]                  @relation("StockHistoryVendor")

  additionalCostMasters     AdditionalCostMaster[]                 @relation("AdditionalCostVendor")
  piSupplierAdditionalCosts PurchaseIntentSupplierAdditionalCost[] @relation("PISupplierAdditionalCostVendor")

  poSupplierAdditionalCosts PurchaseOrderSupplierAdditionalCost[] @relation("POSupplierAdditionalCostVendor")

  paymentTerms PaymentTermMaster[]

  poPaymentSchedules POPaymentSchedule[]

  poPayments                 POPayment[]
  architechuremasters        Architechuremaster[]
  units                      UnitMaster[]
  itemGroups                 ItemGroupMaster[]
  productSupplierMappings    ProductSupplierMapping[]
  popaymentScheduleHistories POPaymentScheduleHistory[]
  clientTypes                ClientTypeMaster[]
  clients                    ClientMaster[]
  box_info_fields            ProjectBoxInfoField[]
  box_info_values            BoxInfoFieldValue[]
  broadcasts                 BroadcastMaster[]          @relation("VendorBroadcasts")
  broadcastCategories        BroadcastCategoryMaster[]  @relation("VendorBroadcastCategories")

  @@index([state_id])
}

model VendorAddress {
  id        Int          @id @default(autoincrement())
  vendor_id Int
  address   String
  state     String
  city      String
  country   String
  pincode   String
  landmark  String
  vendor    VendorMaster @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
}

model VendorTaxInfo {
  id          Int          @id @default(autoincrement())
  tax_no      String
  tax_status  String
  vendor_id   Int
  tax_country String
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  vendor      VendorMaster @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
}

model UserTypeMaster {
  id                        Int                        @id @default(autoincrement())
  user_type                 String
  users                     UserMaster[]
  selfAssignTaskTypeMasters SelfAssignTaskTypeMaster[]
}

model PrivilegeMaster {
  id                    Int                    @id @default(autoincrement())
  vendor_id             Int
  code                  String
  parent_module         String
  child_module          String
  action                String
  label                 String
  description           String?
  is_active             Boolean                @default(true)
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  vendor                VendorMaster           @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  userPrivilegeMappings UserPrivilegeMapping[]

  @@unique([vendor_id, code])
  @@index([vendor_id])
}

model UserMaster {
  id                                         Int                                    @id @default(autoincrement())
  vendor_id                                  Int
  user_name                                  String
  user_contact                               String                                 @unique
  user_email                                 String
  user_timezone                              String
  password                                   String
  user_type_id                               Int
  status                                     String                                 @default("inactive")
  created_at                                 DateTime                               @default(now())
  updated_at                                 DateTime                               @updatedAt
  franchise_id                               Int?
  accountsCreated                            AccountMaster[]                        @relation("AccountCreatedBy")
  accountsUpdated                            AccountMaster[]                        @relation("AccountUpdatedBy")
  companyVendorsCreated                      CompanyVendorsMaster[]                 @relation("CompanyVendorCreatedBy")
  companyVendorsDeleted                      CompanyVendorsMaster[]                 @relation("CompanyVendorDeletedBy")
  companyVendorsUpdated                      CompanyVendorsMaster[]                 @relation("CompanyVendorUpdatedBy")
  operator                                   CutListMachineMapping[]
  createdDefects                             DefectedItem[]
  headSiteSupervisorFranchiseMappingsCreated HeadSiteSupervisorFranchiseMapping[]   @relation("HeadSiteSupervisorFranchiseMappingCreatedBy")
  headSiteSupervisorFranchiseMappings        HeadSiteSupervisorFranchiseMapping[]   @relation("HeadSiteSupervisorFranchiseMappingUser")
  installationIssueLogMaster                 InstallationIssueLogMaster[]
  installationUpdatesCreated                 InstallationUpdate[]
  installersAssigned                         InstallerUserMapping[]                 @relation("InstallerAssignedBy")
  installersCreated                          InstallerUserMaster[]                  @relation("InstallerUserCreatedBy")
  leadActivityStatusLog                      LeadActivityStatusLog[]
  leadChatDocumentsCreated                   LeadChatDocument[]                     @relation("LeadChatDocumentCreatedBy")
  leadChatDocumentsDeleted                   LeadChatDocument[]                     @relation("LeadChatDocumentDeletedBy")
  leadChatMembersAdded                       LeadChatMember[]                       @relation("LeadChatMemberAddedBy")
  leadChatMembers                            LeadChatMember[]                       @relation("LeadChatMemberUser")
  leadChatMentions                           LeadChatMention[]                      @relation("LeadChatMentionUser")
  leadChatMessagesSent                       LeadChatMessage[]                      @relation("LeadChatMessageSender")
  designMeetingsCreated                      LeadDesignMeeting[]                    @relation("DesignMeetingCreatedBy")
  designMeetingsUpdated                      LeadDesignMeeting[]                    @relation("DesignMeetingUpdatedBy")
  designMeetingDocsMappingForCreatedBY       LeadDesignMeetingDocumentsMapping[]    @relation("DesignMeetingDocsMappingCreatedBy")
  clientVisitsCreated                        LeadClientVisit[]                      @relation("ClientVisitCreatedBy")
  clientVisitsUpdated                        LeadClientVisit[]                      @relation("ClientVisitUpdatedBy")
  clientVisitDocumentMappingsCreated         LeadClientVisitDocumentMapping[]       @relation("ClientVisitDocumentMappingCreatedBy")
  designSelectionsCreated                    LeadDesignSelection[]                  @relation("DesignSelectionCreatedBy")
  designSelectionsUpdated                    LeadDesignSelection[]                  @relation("DesignSelectionUpdatedBy")
  chsMappingCreatedBy                        CHSSelectionTypeMapping[]              @relation("CHSMappingCreatedBy")
  chsMappingUpdatedBy                        CHSSelectionTypeMapping[]              @relation("CHSMappingUpdatedBy")
  leadDetailedLogs                           LeadDetailedLogs[]
  leadApprovalRequestDocumentMappings        LeadApprovalRequestDocumentMapping[]   @relation("LeadApprovalRequestDocumentMappingCreatedBy")
  leadDocumentLogs                           LeadDocumentLogs[]
  documentsCreated                           LeadDocuments[]                        @relation("DocumentCreatedBy")
  documentsDeleted                           LeadDocuments[]                        @relation("DocumentDeletedBy")
  leadsAssigned                              LeadMaster[]                           @relation("LeadAssignedTo")
  leadsDelegated                             LeadMaster[]                           @relation("LeadAssignedBy")
  leadsCreated                               LeadMaster[]                           @relation("LeadCreatedBy")
  leadsUpdated                               LeadMaster[]                           @relation("LeadUpdatedBy")
  leadProductsCreated                        LeadProductMapping[]                   @relation("LeadProductCreatedBy")
  productStructureInstances                  LeadProductStructureInstance[]
  supervisorMappingsCreated                  LeadSiteSupervisorMapping[]            @relation("SupervisorCreatedBy")
  supervisorMappings                         LeadSiteSupervisorMapping[]            @relation("SupervisorUser")
  leadStatusLogs                             LeadStatusLogs[]
  leadUserCreated                            LeadUserMapping[]                      @relation("LeadUser_CreatedBy")
  leadUserUpdated                            LeadUserMapping[]                      @relation("LeadUser_UpdatedBy")
  leadUserAsUser                             LeadUserMapping[]                      @relation("LeadUser_User")
  ledgersCreated                             Ledger[]
  miscDocumentsCreated                       MiscellaneousDocument[]                @relation("MiscDocCreatedBy")
  smallOrderRequestsCreated                  SmallOrderRequest[]                    @relation("SmallOrderRequestCreatedBy")
  smallOrderRequestsUpdated                  SmallOrderRequest[]                    @relation("SmallOrderRequestUpdatedBy")
  smallOrderRequestDocumentsCreated          SmallOrderRequestDocument[]            @relation("SmallOrderRequestDocumentCreatedBy")
  miscCreated                                MiscellaneousMaster[]                  @relation("MiscCreatedBy")
  miscUpdated                                MiscellaneousMaster[]                  @relation("MiscUpdatedBy")
  notificationsSent                          Notification[]                         @relation("NotificationSender")
  notificationsReceived                      Notification[]                         @relation("NotificationUser")
  orderLoginDetails                          OrderLoginDetails[]
  orderLoginsUpdated                         OrderLoginDetails[]                    @relation("OrderLoginUpdatedBy")
  orderLoginPoFilesCreated                   OrderLoginPoFileMapping[]              @relation("OrderLoginPoFileCreatedBy")
  orderLoginPoFilesDeleted                   OrderLoginPoFileMapping[]              @relation("OrderLoginPoFileDeletedBy")
  paymentsCreated                            PaymentInfo[]
  leadSuperAdminApprovalsApproved            LeadSuperAdminApprovalLocIns[]         @relation("LeadSuperAdminApprovalApprovedBy")
  leadSuperAdminApprovalsCreated             LeadSuperAdminApprovalLocIns[]         @relation("LeadSuperAdminApprovalCreatedBy")
  createdProjects                            ProjectMaster[]                        @relation("CreatedByUser")
  scanItemsCreated                           ScanAndPackItem[]
  siteReadinessCreated                       SiteReadiness[]                        @relation("SiteReadinessCreatedBy")
  siteReadinessUpdated                       SiteReadiness[]                        @relation("SiteReadinessUpdatedBy")
  activityLogs                               UserActivityLog[]
  documents                                  UserDocument[]
  userPrivilegeMappings                      UserPrivilegeMapping[]
  userGeographicalMappings                   UserGeographicalMapping[]
  leadTasksClosed                            UserLeadTask[]                         @relation("LeadTask_ClosedBy")
  leadTasksCreated                           UserLeadTask[]                         @relation("LeadTask_CreatedBy")
  leadTasksAssigned                          UserLeadTask[]                         @relation("LeadTask_User")
  createdUserMachineMappings                 UserMachineMapping[]                   @relation("UserMachine_createdBy")
  updatedUserMachineMappings                 UserMachineMapping[]                   @relation("UserMachine_updatedBy")
  userMachineMappings                        UserMachineMapping[]                   @relation("UserMachine_user")
  leadAmcContractsCreated                    LeadAmcContract[]                      @relation("LeadAmcContractCreatedBy")
  leadAmcContractsUpdated                    LeadAmcContract[]                      @relation("LeadAmcContractUpdatedBy")
  leadServiceSchedulesCreated                LeadServiceSchedule[]                  @relation("LeadServiceScheduleCreatedBy")
  leadServiceSchedulesUpdated                LeadServiceSchedule[]                  @relation("LeadServiceScheduleUpdatedBy")
  leadServiceSchedulesCompleted              LeadServiceSchedule[]                  @relation("LeadServiceScheduleCompletedBy")
  leadServiceSchedulesRejected               LeadServiceSchedule[]                  @relation("LeadServiceScheduleRejectedBy")
  fastProductionRequestsAsRequester          FastProductionRequest[]                @relation("FastProductionRequester")
  fastProductionRequestsCreated              FastProductionRequest[]                @relation("FastProductionCreatedBy")
  fastProductionRequestsUpdated              FastProductionRequest[]                @relation("FastProductionUpdatedBy")
  fastProductionRequestsRevoked              FastProductionRequest[]                @relation("FastProductionRevokedBy")
  fastProductionRequestBatchesAsRequester    FastProductionRequestBatch[]           @relation("FastProductionBatchRequester")
  fastProductionRequestBatchesCreated        FastProductionRequestBatch[]           @relation("FastProductionBatchCreatedBy")
  fastProductionRequestBatchesUpdated        FastProductionRequestBatch[]           @relation("FastProductionBatchUpdatedBy")
  fastProductionRequestBatchesRevoked        FastProductionRequestBatch[]           @relation("FastProductionBatchRevokedBy")
  fastProductionApprovals                    FastProductionApproval[]               @relation("FastProductionApprover")
  fastProductionRequestDocumentsCreated      FastProductionRequestDocument[]        @relation("FastProductionDocCreatedBy")
  fastProductionStatusLogs                   FastProductionStatusLog[]              @relation("FastProductionStatusActor")
  franchise                                  FranchiseMaster?                       @relation(fields: [franchise_id], references: [id])
  user_type                                  UserTypeMaster                         @relation(fields: [user_type_id], references: [id])
  vendor                                     VendorMaster                           @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  sessions                                   UserSession[]                          @relation("UserSessions")
  revokedSessions                            UserSession[]                          @relation("UserSessionRevokedBy")
  pushTokens                                 UserPushToken[]
  externalPlatformTokensCreated              ExternalPlatformToken[]                @relation("ExternalPlatformTokenCreatedBy")
  externalPlatformTokensUpdated              ExternalPlatformToken[]                @relation("ExternalPlatformTokenUpdatedBy")
  completionPhotos                           DefectCompletionPhoto[]
  projectCategoriesVendorMappingsCreated     ProjectCategoriesMasterVendorMapping[] @relation("ProjectCategoriesVendorMapping_createdBy")
  projectCategoriesVendorMappingsUpdated     ProjectCategoriesMasterVendorMapping[] @relation("ProjectCategoriesVendorMapping_updatedBy")
  boxesFactoryOut                            BoxMaster[]                            @relation("BoxFactoryOutBy")
  boxesSiteIn                                BoxMaster[]                            @relation("BoxSiteInBy")
  mappingSiteIns                             CutListMachineMapping[]                @relation("MappingSiteInBy")
  purchaseIntentsCreated                     PurchaseIntentMaster[]                 @relation("PICreatedBy")
  purchaseIntentsUpdated                     PurchaseIntentMaster[]                 @relation("PIUpdatedBy")
  purchaseIntentsApproved                    PurchaseIntentMaster[]                 @relation("PIApprovedBy")
  purchaseIntentsRejected                    PurchaseIntentMaster[]                 @relation("PIRejectedBy")
  purchaseIntentsDeleted                     PurchaseIntentMaster[]                 @relation("PIDeletedBy")
  purchaseIntentStatusLogs                   PurchaseIntentStatusLog[]              @relation("PIStatusLogChangedBy")
  purchaseOrdersCreated                      PurchaseOrderMaster[]                  @relation("POCreatedBy")
  purchaseOrdersUpdated                      PurchaseOrderMaster[]                  @relation("POUpdatedBy")
  grnsCreated                                GRNMaster[]                            @relation("GRNCreatedBy")
  grnsUpdated                                GRNMaster[]                            @relation("GRNUpdatedBy")
  grnsConfirmed                              GRNMaster[]                            @relation("GRNConfirmedBy")
  dcnsCreated                                DebitCreditNote[]                      @relation("DCNCreatedBy")
  dcnsSettled                                DebitCreditNote[]                      @relation("DCNSettledBy")
  redeliveriesCreated                        RedeliveryRequest[]                    @relation("RDCreatedBy")
  poItemsCreated                             PurchaseOrderItem[]                    @relation("POItemCreatedBy")
  poItemsUpdated                             PurchaseOrderItem[]                    @relation("POItemUpdatedBy")
  poItemsDeleted                             PurchaseOrderItem[]                    @relation("POItemDeletedBy")
  stockHistories                             ProductStockHistory[]                  @relation("StockHistoryUser")
  architechuremasters                        Architechuremaster[]
  leadSpecificationsCreated                  LeadSpecificationsMaster[]             @relation("LeadSpecificationsCreatedBy")
  leadCarcassMaterialMappingsCreated         LeadCarcassMaterialMapping[]           @relation("LeadCarcassMaterialMappingCreatedBy")
  leadShutterMaterialMappingsCreated         LeadShutterMaterialMapping[]           @relation("LeadShutterMaterialMappingCreatedBy")
  leadHardwareMappingsCreated                LeadHardwareMapping[]                  @relation("LeadHardwareMappingCreatedBy")
  leadLightCarcasUnitMappingsCreated         LeadLightCarcasUnitMapping[]           @relation("LeadLightCarcasUnitMappingCreatedBy")
  leadOtherAppliancesMappingsCreated         LeadOtherAppliancesMapping[]           @relation("LeadOtherAppliancesMappingCreatedBy")
  specificationDocumentMappingsCreated       specificationDocumentMapping[]         @relation("SpecificationDocumentMappingCreatedBy")
  poPaymentScheduleHistories                 POPaymentScheduleHistory[]
  boxesPackedBy                              BoxMaster[]                            @relation("BoxPackedByUser")
  broadcastsCreated                          BroadcastMaster[]                      @relation("BroadcastCreatedBy")
  broadcastsUpdated                          BroadcastMaster[]                      @relation("BroadcastUpdatedBy")
  broadcastCategoriesCreated                 BroadcastCategoryMaster[]              @relation("BroadcastCategoryCreatedBy")
  broadcastAudienceCreated                   BroadcastAudienceMapping[]             @relation("BroadcastAudienceCreatedBy")
  broadcastAudienceUpdated                   BroadcastAudienceMapping[]             @relation("BroadcastAudienceUpdatedBy")
  broadcastAttachmentsCreated                BroadcastAttachment[]                  @relation("BroadcastAttachmentCreatedBy")
  broadcastAttachmentsUpdated                BroadcastAttachment[]                  @relation("BroadcastAttachmentUpdatedBy")
  broadcastReads                             BroadcastRead[]                        @relation("BroadcastReadUser")
  broadcastReadsCreated                      BroadcastRead[]                        @relation("BroadcastReadCreatedBy")
  broadcastReadsUpdated                      BroadcastRead[]                        @relation("BroadcastReadUpdatedBy")
  notificationQueuesCreated                  NotificationQueue[]                    @relation("NotificationQueueCreatedBy")
  notificationQueuesUpdated                  NotificationQueue[]                    @relation("NotificationQueueUpdatedBy")
}

model UserDocument {
  id              Int        @id @default(autoincrement())
  user_id         Int
  document_name   String
  document_number String
  filename        String
  user            UserMaster @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model UserSession {
  id                 Int                  @id @default(autoincrement())
  user_id            Int
  vendor_id          Int
  refresh_token_hash String
  access_jti         String?              @unique
  device_id          String?
  device_name        String?
  platform           String?
  ip_address         String?
  user_agent         String?
  login_type         UserSessionLoginType @default(USER_LOGIN)
  status             UserSessionStatus    @default(active)
  is_current         Boolean?             @default(true)
  last_seen_at       DateTime?            @default(now())
  expires_at         DateTime
  logged_out_at      DateTime?
  revoked_at         DateTime?
  revoked_by         Int?
  revoke_reason      String?
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  user               UserMaster           @relation("UserSessions", fields: [user_id], references: [id], onDelete: Cascade)
  vendor             VendorMaster         @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  revokedBy          UserMaster?          @relation("UserSessionRevokedBy", fields: [revoked_by], references: [id])

  @@index([user_id, status])
  @@index([user_id, created_at])
  @@index([vendor_id, status])
  @@index([device_id])
}

model UserPrivilegeMapping {
  id           Int             @id @default(autoincrement())
  vendor_id    Int
  user_id      Int
  privilege_id Int
  is_allowed   Boolean         @default(false)
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt
  vendor       VendorMaster    @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  user         UserMaster      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  privilege    PrivilegeMaster @relation(fields: [privilege_id], references: [id], onDelete: Cascade)

  @@unique([vendor_id, user_id, privilege_id])
  @@index([vendor_id])
  @@index([user_id])
  @@index([privilege_id])
}

model ProjectMaster {
  id                Int         @id @default(autoincrement())
  project_name      String
  vendor_id         Int
  client_id         Int?
  created_by        Int
  project_status    String      @default("Initiated")
  created_at        DateTime    @default(now())
  unique_project_id String
  is_grouping       Boolean     @default(false)
  lead_id           Int?
  order_no          String?
  client_name       String?
  client_address    String?
  client_contact_no String?
  packing_type      PackingType @default(DEFAULT)
  updated_by        Int?
  updated_at        DateTime?   @updatedAt

  track_trace_status    String                  @default("Not Started")
  track_started_at      DateTime?
  track_completed_at    DateTime?
  boxes                 BoxMaster[]
  CutList               CutList[]
  cutListMachineMapping CutListMachineMapping[]
  defectedItems         DefectedItem[]
  details               ProjectDetails[]
  items                 ProjectItemsMaster[]
  client                ClientMaster?           @relation(fields: [client_id], references: [id], onDelete: Cascade)
  createdByUser         UserMaster              @relation("CreatedByUser", fields: [created_by], references: [id], onDelete: Cascade)
  lead                  LeadMaster?             @relation(fields: [lead_id], references: [id])
  vendor                VendorMaster            @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  scanItems             ScanAndPackItem[]
  box_info_fields       ProjectBoxInfoField[]
  box_info_values       BoxInfoFieldValue[]
}

model ProjectDetails {
  id                        Int                  @id @default(autoincrement())
  project_id                Int
  vendor_id                 Int
  lead_id                   Int?
  total_items               Int                  @default(0)
  total_packed              Int                  @default(0)
  total_unpacked            Int                  @default(0)
  actual_completion_date    DateTime?
  estimated_completion_date DateTime?
  start_date                DateTime             @default(now())
  is_grouping               Boolean              @default(false)
  room_name                 String
  boxes                     BoxMaster[]          @relation("BoxDetails")
  leadMaster                LeadMaster?          @relation(fields: [lead_id], references: [id])
  project                   ProjectMaster        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  vendor                    VendorMaster         @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  items                     ProjectItemsMaster[]
  scanItems                 ScanAndPackItem[]    @relation("ItemDetails")
}

model ProjectItemsMaster {
  id                 Int            @id @default(autoincrement())
  project_id         Int
  vendor_id          Int
  category           String
  unique_id          String
  item_name          String
  L1                 String
  L2                 String
  L3                 String
  qty                Int
  project_details_id Int
  group              String
  weight             Float          @default(0)
  details            ProjectDetails @relation(fields: [project_details_id], references: [id], onDelete: Cascade)
  project            ProjectMaster  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  vendor             VendorMaster   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
}

model BoxMaster {
  id                    Int                     @id @default(autoincrement())
  project_id            Int
  vendor_id             Int
  lead_id               Int?
  box_name              String
  box_status            BoxStatus
  created_by            Int
  created_date          DateTime                @default(now())
  deleted_at            DateTime?
  deleted_by            Int?
  is_deleted            Boolean                 @default(false)
  project_details_id    Int
  factory_out_by        Int?
  factory_out_at        DateTime?
  site_in_by            Int?
  site_in_at            DateTime?
  packed_by             Int?
