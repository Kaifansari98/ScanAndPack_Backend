model PurchaseIntentMaster {
  id               Int                    @id @default(autoincrement())
  vendor_id        Int
  intent_no        String                 @unique // PI-000001
  category_id      Int?
  status           PurchaseIntentStatus   @default(Draft)
  priority         PurchaseIntentPriority @default(Medium)
  remarks          String?
  created_by       Int
  updated_by       Int?
  approved_by      Int?
  approved_at      DateTime?
  rejected_by      Int?
  rejected_at      DateTime?
  rejection_reason String?
  is_deleted       Boolean                @default(false)
  deleted_at       DateTime?
  deleted_by       Int?
  created_at       DateTime               @default(now())
  updated_at       DateTime               @updatedAt
  amount           Decimal?               @db.Decimal(18, 2)
  tax_amount       Decimal?               @db.Decimal(18, 2)
  total_amount     Decimal?               @db.Decimal(18, 2)

  // Relations
  vendor                  VendorMaster                           @relation("PIVendor", fields: [vendor_id], references: [id], onDelete: Cascade)
  category                ProjectCategoriesMaster?               @relation("PICategory", fields: [category_id], references: [id])
  createdBy               UserMaster                             @relation("PICreatedBy", fields: [created_by], references: [id])
  updatedBy               UserMaster?                            @relation("PIUpdatedBy", fields: [updated_by], references: [id])
  approvedBy              UserMaster?                            @relation("PIApprovedBy", fields: [approved_by], references: [id])
  rejectedBy              UserMaster?                            @relation("PIRejectedBy", fields: [rejected_by], references: [id])
  deletedBy               UserMaster?                            @relation("PIDeletedBy", fields: [deleted_by], references: [id])
  supplierAdditionalCosts PurchaseIntentSupplierAdditionalCost[] @relation("PISupplierAdditionalCosts")

  items          PurchaseIntentItem[]
  statusLogs     PurchaseIntentStatusLog[]
  purchaseOrders PurchaseOrderMaster[]     @relation("POIntent")

  @@index([vendor_id])
  @@index([category_id])
  @@index([status])
  @@index([created_by])
}

model PurchaseIntentItem {
  id                 Int      @id @default(autoincrement())
  purchase_intent_id Int
  product_id         Int
  uom                String?
  remarks            String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  purchaseIntent PurchaseIntentMaster @relation(fields: [purchase_intent_id], references: [id], onDelete: Cascade)
  product        ProductMaster        @relation("PIItemProduct", fields: [product_id], references: [id])

  vendorMappings PurchaseIntentItemVendorMapping[]

  @@index([purchase_intent_id])
  @@index([product_id])
}

model PurchaseIntentItemVendorMapping {
  id                      Int       @id @default(autoincrement())
  purchase_intent_item_id Int
  company_vendor_id       Int
  required_qty            Decimal   @db.Decimal(12, 2) // ← moved here
  required_by_date        DateTime? // ← moved here
  estimated_price         Decimal?  @db.Decimal(12, 2)
  remarks                 String?
  is_selected             Boolean   @default(false)
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  mrp             Decimal? @db.Decimal(12, 2) // Max Retail Price
  discount_pct    Decimal? @db.Decimal(5, 2) // % discount on MRP
  rate            Decimal? @db.Decimal(12, 2) // = MRP * (1 - discount/100), editable
  tax_pct         Decimal? @db.Decimal(5, 2) // total GST % (pulled from HsnProductMapping)
  cgst_pct        Decimal? @db.Decimal(5, 2)
  sgst_pct        Decimal? @db.Decimal(5, 2)
  igst_pct        Decimal? @db.Decimal(5, 2)
  tax_amount      Decimal? @db.Decimal(12, 2) // = rate * qty * tax_pct / 100
  amount          Decimal? @db.Decimal(12, 2) // = rate * qty (before tax)
  total_amount    Decimal? @db.Decimal(12, 2) // = amount + tax_amount
  payment_term_id Int?

  purchaseIntentItem PurchaseIntentItem   @relation(fields: [purchase_intent_item_id], references: [id], onDelete: Cascade)
  companyVendor      CompanyVendorsMaster @relation("PIItemVendor", fields: [company_vendor_id], references: [id])
  purchaseOrderItems PurchaseOrderItem[]  @relation("POFromPI")
  paymentTerm        PaymentTermMaster?   @relation("PIVendorPaymentTerm", fields: [payment_term_id], references: [id], onDelete: SetNull)

  @@index([payment_term_id])
  @@index([purchase_intent_item_id])
  @@index([company_vendor_id])
}

model PurchaseIntentStatusLog {
